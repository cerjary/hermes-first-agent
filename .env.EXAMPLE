# Never commit real values.
# LLM provider/model credentials are inherited selectively from the Hermes
# default profile during normal First Agent installation.

# First Agent access control
# FIRST_AGENT_ACCESS_MODE=passcode
# FIRST_AGENT_PASSCODE_SALT=<generated>
# FIRST_AGENT_PASSCODE_HASH=<generated>
# FIRST_AGENT_PASSCODE_ITERATIONS=210000
# For testing-only open access use:
# FIRST_AGENT_ACCESS_MODE=allow_all

# LINE
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# LINE_ALLOW_ALL_USERS=false
LINE_PUBLIC_URL=
# LINE_PORT=8646

# Telegram
TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOW_ALL_USERS=false

# Weixin / iLink credentials are normally created by:
# hermes -p <agent-id> gateway setup
# WEIXIN_ACCOUNT_ID=
# WEIXIN_TOKEN=
# WEIXIN_DM_POLICY=pairing
# WEIXIN_ALLOW_ALL_USERS=false
